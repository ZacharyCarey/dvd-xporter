<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DvdXporter.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      The app's and the render server's version, as both are built with this project (see RenderServerProtocol.Version).
      Raise it when a change would make a server built before it export differently, e.g. name files differently.
    -->
    <Version>1.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Iso639" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DiscDecoders/DiscDecoders/DiscDecoders.csproj" />
    <ProjectReference Include="../FFmpeg/FFmpeg.csproj" />
  </ItemGroup>

</Project>
