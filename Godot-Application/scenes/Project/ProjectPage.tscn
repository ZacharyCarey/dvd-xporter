[node name="OrderHint" type="Label" parent="Layout/Body/DiscsPanel" unique_id=1715529444]
unique_name_in_owner = true
visible = false
modulate = Color(1, 1, 1, 0.55)
layout_mode = 2
tooltip_text = "The order of releases matters when more than one has the same episode or movie, e.g. a season on both Blu-ray and DVD. Each file is made from the highest release in this list that you have the discs for, and the others are skipped. Put the version you'd rather have first. Releases you don't have are passed over, so a shared project can hold every version. You can still pick another version for a file in the Export step."
mouse_filter = 1
mouse_default_cursor_shape = 16
text = "Releases higher in the list are preferred when several have the same episode or movie (e.g. Blu-ray and DVD). Hover here for more."
autowrap_mode = 3

