[node name="EveryFrameRow" type="HBoxContainer" parent="Content"]
layout_mode = 2
tooltip_text = "Decodes every frame of the disc when it's read, to tell whether its video is interlaced, telecined or progressive, and where. Takes about as long as playing the disc at several times speed. Without it, the video's picture type is Unknown.\n\nDVDs are often interlaced or telecined; Blu-rays seldom are, and take far longer to check."
theme_override_constants/separation = 8

[node name="EveryFrameLabel" type="Label" parent="Content/EveryFrameRow"]
layout_mode = 2
mouse_filter = 1
text = "Check every frame for interlacing:"

[node name="EveryFrameOption" type="OptionButton" parent="Content/EveryFrameRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Decodes every frame of the disc when it's read, to tell whether its video is interlaced, telecined or progressive, and where. Takes about as long as playing the disc at several times speed. Without it, the video's picture type is Unknown.\n\nDVDs are often interlaced or telecined; Blu-rays seldom are, and take far longer to check."
selected = 0
item_count = 3
popup/item_0/text = "On DVDs"
