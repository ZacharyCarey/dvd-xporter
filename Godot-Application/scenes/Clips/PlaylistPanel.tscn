[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/Clips/PlaylistPanel.cs" id="1_panel"]
[ext_resource type="Script" path="res://scenes/Clips/PlaylistEntryTree.cs" id="2_entries"]
[ext_resource type="PackedScene" path="res://scenes/Clips/PlaylistImportPopup.tscn" id="3_popup"]
[ext_resource type="Texture2D" uid="uid://b8yre2xufa736" path="res://icons/remove.svg" id="4_remove"]

[node name="PlaylistPanel" type="PanelContainer"]
custom_minimum_size = Vector2(300, 0)
script = ExtResource("1_panel")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PlaylistButtons" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="ImportButton" type="Button" parent="Margin/VBox/PlaylistButtons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Import..."

[node name="NewPlaylistButton" type="Button" parent="Margin/VBox/PlaylistButtons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Create an empty playlist"
text = "New"

[node name="PlaylistList" type="Tree" parent="Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
size_flags_vertical = 3
size_flags_stretch_ratio = 0.5
hide_root = true

[node name="NameRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="PlaylistNameEdit" type="LineEdit" parent="Margin/VBox/NameRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Playlist name"
placeholder_text = "Playlist name"
editable = false

[node name="RemovePlaylistButton" type="Button" parent="Margin/VBox/NameRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Remove this playlist"
disabled = true
text = "Remove"

[node name="PlaylistSourceLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
modulate = Color(1, 1, 1, 0.65)
layout_mode = 2
text_overrun_behavior = 3

[node name="EntryTree" type="Tree" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
columns = 3
column_titles_visible = true
hide_root = true
select_mode = 1
script = ExtResource("2_entries")
RemoveIcon = ExtResource("4_remove")

[node name="EntryHint" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
modulate = Color(1, 1, 1, 0.65)
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
autowrap_mode = 3

[node name="PlaylistImportPopup" parent="." instance=ExtResource("3_popup")]
unique_name_in_owner = true

[node name="RemovePlaylistDialog" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Remove Playlist"
ok_button_text = "Remove"
dialog_autowrap = true
size = Vector2i(420, 140)

[connection signal="pressed" from="Margin/VBox/PlaylistButtons/ImportButton" to="." method="On_ImportButton_Pressed"]
[connection signal="pressed" from="Margin/VBox/PlaylistButtons/NewPlaylistButton" to="." method="On_NewPlaylistButton_Pressed"]
[connection signal="item_selected" from="Margin/VBox/PlaylistList" to="." method="On_PlaylistList_ItemSelected"]
[connection signal="text_submitted" from="Margin/VBox/NameRow/PlaylistNameEdit" to="." method="On_PlaylistNameEdit_TextSubmitted"]
[connection signal="focus_exited" from="Margin/VBox/NameRow/PlaylistNameEdit" to="." method="On_PlaylistNameEdit_FocusExited"]
[connection signal="pressed" from="Margin/VBox/NameRow/RemovePlaylistButton" to="." method="On_RemovePlaylistButton_Pressed"]
[connection signal="item_selected" from="Margin/VBox/EntryTree" to="Margin/VBox/EntryTree" method="On_EntryTree_ItemSelected"]
[connection signal="item_activated" from="Margin/VBox/EntryTree" to="Margin/VBox/EntryTree" method="On_EntryTree_ItemActivated"]
[connection signal="button_clicked" from="Margin/VBox/EntryTree" to="Margin/VBox/EntryTree" method="On_EntryTree_ButtonClicked"]
[connection signal="confirmed" from="RemovePlaylistDialog" to="." method="On_RemovePlaylistDialog_Confirmed"]
[connection signal="PlaylistChosen" from="PlaylistImportPopup" to="." method="On_PlaylistImportPopup_PlaylistChosen"]
[connection signal="EntrySelected" from="Margin/VBox/EntryTree" to="." method="On_EntryTree_EntrySelected"]
[connection signal="EntryActivated" from="Margin/VBox/EntryTree" to="." method="On_EntryTree_EntryActivated"]
[connection signal="EntriesChanged" from="Margin/VBox/EntryTree" to="." method="On_EntryTree_EntriesChanged"]
