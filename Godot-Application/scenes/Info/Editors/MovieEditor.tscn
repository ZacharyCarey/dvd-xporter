[node name="MovieEditor" type="VBoxContainer"]
theme_override_constants/separation = 8
script = ExtResource("1_script")

[node name="ImportRow" parent="." instance=ExtResource("2_import")]
unique_name_in_owner = true
layout_mode = 2

[node name="Spacer1" type="Control" parent="."]
custom_minimum_size = Vector2(0, 8)
layout_mode = 2

[node name="Header1" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Movie Details"

[node name="Grid" type="GridContainer" parent="."]
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 8
columns = 2

[node name="TitleLabel" type="Label" parent="Grid"]
custom_minimum_size = Vector2(170, 0)
layout_mode = 2
text = "Title"

[node name="TitleEdit" type="LineEdit" parent="Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Required"

[node name="YearLabel" type="Label" parent="Grid"]
custom_minimum_size = Vector2(170, 0)
layout_mode = 2
text = "Year"

[node name="YearEdit" type="LineEdit" parent="Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "A number from 1880 to 2200, or blank."
placeholder_text = "e.g. 1999"

[node name="OriginalTitleLabel" type="Label" parent="Grid"]
custom_minimum_size = Vector2(170, 0)
layout_mode = 2
text = "Original title"

[node name="OriginalTitleEdit" type="LineEdit" parent="Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "If different, e.g. in its original language"

[node name="SortTitleLabel" type="Label" parent="Grid"]
custom_minimum_size = Vector2(170, 0)
layout_mode = 2
text = "Sort title"

[node name="SortTitleEdit" type="LineEdit" parent="Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Optional: the text Emby sorts the movie by in the library instead of its title, written as typed."
placeholder_text = "e.g. Matrix, The"

[node name="PremieredLabel" type="Label" parent="Grid"]
custom_minimum_size = Vector2(170, 0)
