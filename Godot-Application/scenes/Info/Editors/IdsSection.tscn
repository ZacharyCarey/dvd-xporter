[node name="ImdbEdit" type="LineEdit" parent="Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "e.g. tt0303461"

[connection signal="text_changed" from="Grid/TmdbEdit" to="." method="On_TmdbEdit_TextChanged"]
[connection signal="text_changed" from="Grid/TvdbEdit" to="." method="On_TvdbEdit_TextChanged"]
