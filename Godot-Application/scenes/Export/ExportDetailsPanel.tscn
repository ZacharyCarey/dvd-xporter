[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/Export/ExportDetailsPanel.cs" id="1_details"]

[node name="ExportDetailsPanel" type="PanelContainer"]
custom_minimum_size = Vector2(380, 0)
script = ExtResource("1_details")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 10

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="DetailTitle" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Pick a file to see its details."
autowrap_mode = 3

[node name="DetailState" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="DetailInfo" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
modulate = Color(1, 1, 1, 0.75)
layout_mode = 2
autowrap_mode = 3

[node name="ProblemsLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Problems"

[node name="ProblemList" type="ItemList" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
tooltip_text = "Double-click a problem to see it in Transcoding"

[node name="DetailButtons" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="ShowInTranscodingButton" type="Button" parent="Margin/VBox/DetailButtons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Open this file's canvas in Transcoding"
text = "Show in Transcoding"

[node name="ShowFileButton" type="Button" parent="Margin/VBox/DetailButtons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Show the exported file in your file manager"
text = "Show File"

[node name="OpenLogButton" type="Button" parent="Margin/VBox/DetailButtons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Open ffmpeg's log of this file's export"
text = "Open Log"

[connection signal="item_activated" from="Margin/VBox/ProblemList" to="." method="On_ProblemList_ItemActivated"]
[connection signal="pressed" from="Margin/VBox/DetailButtons/ShowInTranscodingButton" to="." method="On_ShowInTranscodingButton_Pressed"]
[connection signal="pressed" from="Margin/VBox/DetailButtons/ShowFileButton" to="." method="On_ShowFileButton_Pressed"]
[connection signal="pressed" from="Margin/VBox/DetailButtons/OpenLogButton" to="." method="On_OpenLogButton_Pressed"]
