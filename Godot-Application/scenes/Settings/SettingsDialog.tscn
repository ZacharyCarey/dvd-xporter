[node name="ServerHelpLabel" type="Label" parent="Tabs/Server/Layout"]
custom_minimum_size = Vector2(700, 0)
layout_mode = 2
text = "A render server is another computer running DVD Xporter Render Server (dvdx-server). The Export step can send it files to export into its own library, so this computer is free while they're made. Its discs are marked on the project overview, and the Clip Renamer can play them."
autowrap_mode = 3
modulate = Color(1, 1, 1, 0.75)

[node name="ServerWarningLabel" type="Label" parent="Tabs/Server/Layout"]
custom_minimum_size = Vector2(700, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.91, 0.72, 0.29, 1)
text = "Only use a render server on a local network you trust. Projects and discs are sent to it unencrypted, and anyone on the network with its access key can export with it."
autowrap_mode = 3

