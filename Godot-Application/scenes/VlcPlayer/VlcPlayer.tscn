[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/VlcPlayer/VlcPlayer.cs" id="1_vlc"]

[sub_resource type="Shader" id="Shader_bgrx"]
code = "shader_type canvas_item;

// VLC's RV32 frames are stored B, G, R, unused; show them as RGB.
void fragment() {
	vec4 c = texture(TEXTURE, UV);
	COLOR = vec4(c.b, c.g, c.r, 1.0);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_bgrx"]
shader = SubResource("Shader_bgrx")

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_frame"]
bg_color = Color(0, 0, 0, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bubble"]
content_margin_left = 6.0
content_margin_top = 2.0
content_margin_right = 6.0
content_margin_bottom = 2.0
bg_color = Color(0.1, 0.1, 0.11, 0.92)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_debug"]
content_margin_left = 7.0
content_margin_top = 7.0
content_margin_right = 7.0
content_margin_bottom = 7.0
bg_color = Color(0.230469, 0.230469, 0.230469, 0.556863)
corner_radius_bottom_right = 14

[node name="VlcPlayer" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
