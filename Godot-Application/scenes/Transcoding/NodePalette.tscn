[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/Transcoding/NodePalette.cs" id="1_script"]

[node name="NodePalette" type="VBoxContainer"]
size_flags_vertical = 3
theme_override_constants/separation = 8
script = ExtResource("1_script")

[node name="PaletteLabel" type="Label" parent="."]
layout_mode = 2
text = "Nodes"

[node name="PaletteSearch" type="LineEdit" parent="."]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Search nodes (Ctrl+F)"
clear_button_enabled = true

[node name="PaletteTree" type="Tree" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
hide_root = true

[node name="PaletteHint" type="Label" parent="."]
modulate = Color(1, 1, 1, 0.55)
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
text = "Drag a node onto the canvas, double-click it, or right-click the canvas. Drag from an output into empty space to add a node already connected. Press Space to search for a node at the mouse, and F1 for all shortcuts."
autowrap_mode = 3

[connection signal="text_changed" from="PaletteSearch" to="." method="On_PaletteSearch_TextChanged"]
[connection signal="text_submitted" from="PaletteSearch" to="." method="On_PaletteSearch_TextSubmitted"]
[connection signal="gui_input" from="PaletteSearch" to="." method="On_PaletteSearch_GuiInput"]
[connection signal="item_activated" from="PaletteTree" to="." method="On_PaletteTree_ItemActivated"]
