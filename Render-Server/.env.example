# Copy to .env (beside docker-compose.yml) and change what's needed. Paths are on this computer.

# The image's name and version, e.g. ghcr.io/you/dvdx-server and 1.0.0 to push it to a registry
DVDX_IMAGE=dvdx-server
DVDX_VERSION=latest

# The ffmpeg series built in (see the Dockerfile)
FFMPEG_SERIES=8.1

# What the app calls it (blank for the computer's name)
DVDX_NAME=
# Its access key, to choose one (blank: it makes one the first time it starts, and shows it in its log)
DVDX_ACCESS_KEY=

# Who owns what it writes: run "id -u" and "id -g" for yours
PUID=1000
PGID=1000

# Its settings, jobs and the discs sent for them
DVDX_DATA=./data
# The Disc Library (folders of ISOs, VIDEO_TS or BDMV rips)
DVDX_DISCS=/srv/discs
# The Emby libraries it exports into
DVDX_MOVIES=/srv/media/movies
DVDX_SHOWS=/srv/media/shows
